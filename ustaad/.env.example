# ── LLM ──────────────────────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ── Hindsight (Vectorize) ─────────────────────────────────────────────────────
HINDSIGHT_BASE_URL=
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=ustaad-site1

# ── MQTT ─────────────────────────────────────────────────────────────────────
MQTT_HOST=localhost
MQTT_PORT=1883

# ── Serial (FRDM board) ───────────────────────────────────────────────────────
SERIAL_PORT=/dev/ttyACM0

# ── Runtime flags ────────────────────────────────────────────────────────────
# Set SIMULATOR=1 to run fully in-process (no hardware, no broker required).
SIMULATOR=1

# ── Site / machine identity ───────────────────────────────────────────────────
MACHINE_ID=Pump-2
SITE=site1

# ── Closed-loop timing ───────────────────────────────────────────────────────
VERIFY_SECONDS=90
SOFT_RECALL_INTERVAL_S=30
